# GitHub organization audit log -> OCSF 1.9.0.
#
# Dispatch:
#   *.sso_response / authentication        -> 3002 Authentication
#   user.*                                -> 3007 User Management
#   team.*                                -> 3006 Group Management
#   org.* / business.* / repository.*     -> 3004 Entity Management
#   everything else (git.push, ...)       -> 6003 API Activity
#
# The audit log has no outcome field, so status stays unknown except for SSO responses,
# which are successful by definition. Actor IP and country come from actor_ip and
# actor_location; only valid IPs are put on src_endpoint.

text = string(.message) ?? ""
raw = parse_json(text) ?? null
if !is_object(raw) && .action != null {
  raw = .
}
if !is_object(raw) {
  abort "not a GitHub audit log event"
}
action = string(raw.action) ?? ""
if action == "" {
  abort "GitHub audit event without action"
}
action_l = downcase(action)

ingested = timestamp(%ironcyde.ingested_at) ?? now()
time_ms = to_unix_timestamp(ingested, unit: "milliseconds")
raw_time = get(raw, ["@timestamp"]) ?? null
if is_integer(raw_time) || is_float(raw_time) {
  time_ms = to_int!(raw_time)
}

org = string(raw.org) ?? ""
business = string(raw.business) ?? ""
org_id = to_int(raw.org_id) ?? 0
business_id = to_int(raw.business_id) ?? 0
document_uid = string(get(raw, ["_document_id"]) ?? "") ?? ""
actor_id = to_int(raw.actor_id) ?? 0
user_id = to_int(raw.user_id) ?? 0
actor_name = string(raw.actor) ?? ""
user_name = string(raw.user) ?? ""
team = string(raw.team) ?? ""
issuer = string(raw.issuer) ?? ""
email = string(raw.external_identity_nameid) ?? ""

actor_user = {"type_id": 1, "type": "User"}
if actor_name != "" {
  actor_user.name = actor_name
}
if actor_id > 0 {
  actor_user.uid = to_string(actor_id)
}
if email != "" && contains(email, "@") {
  actor_user.email_addr = email
}
account_name = org
if account_name == "" {
  account_name = business
}
account_uid = ""
if org_id > 0 {
  account_uid = to_string(org_id)
} else if business_id > 0 {
  account_uid = to_string(business_id)
}
account = {"type_id": 99, "type": "Other"}
if account_name != "" {
  account.name = account_name
}
if account_uid != "" {
  account.uid = account_uid
}
if length(keys(account)) > 0 {
  actor_user.account = account
}
actor = {"user": actor_user}
session_uid = to_int(raw.actor_session) ?? 0
if session_uid > 0 {
  actor.session = {"uid": to_string(session_uid)}
}

target_user = {}
if user_name != "" {
  target_user.name = user_name
  target_user.type_id = 1
  target_user.type = "User"
}
if user_id > 0 {
  target_user.uid = to_string(user_id)
}
if length(target_user) > 0 && email != "" && contains(email, "@") && (user_name == actor_name || user_id == actor_id) {
  target_user.email_addr = email
}

# --- class dispatch ------------------------------------------------------

class_uid = 6003
category_uid = 6
activity_id = 99
if contains(action_l, "sso") || action_l == "business.sso_response" ||
  starts_with(action_l, "user.authentication") {
  class_uid = 3002
  category_uid = 3
  activity_id = 1
} else if starts_with(action_l, "user.") {
  class_uid = 3007
  category_uid = 3
  activity_id = 2
  if contains(action_l, "create") || contains(action_l, "invite") {
    activity_id = 1
  } else if contains(action_l, "remove") || contains(action_l, "destroy") || contains(action_l, "delete") {
    activity_id = 3
  } else if contains(action_l, "suspend") || contains(action_l, "disable") || contains(action_l, "block") {
    activity_id = 5
  } else if contains(action_l, "unsuspend") || contains(action_l, "enable") || contains(action_l, "unblock") {
    activity_id = 4
  } else if contains(action_l, "lock") {
    activity_id = 6
  } else if contains(action_l, "unlock") {
    activity_id = 7
  }
} else if starts_with(action_l, "team.") {
  class_uid = 3006
  category_uid = 3
  activity_id = 99
  if contains(action_l, "add_member") {
    activity_id = 3
  } else if contains(action_l, "remove_member") {
    activity_id = 4
  } else if contains(action_l, "create") {
    activity_id = 6
  } else if contains(action_l, "destroy") || contains(action_l, "delete") {
    activity_id = 5
  } else if contains(action_l, "update") {
    activity_id = 9
  }
} else if starts_with(action_l, "org.") || starts_with(action_l, "business.") ||
  starts_with(action_l, "repository.") || starts_with(action_l, "org_") {
  class_uid = 3004
  category_uid = 3
  activity_id = 99
  if contains(action_l, "create") || contains(action_l, "add") {
    activity_id = 1
  } else if contains(action_l, "destroy") || contains(action_l, "delete") || contains(action_l, "remove") {
    activity_id = 4
  } else if contains(action_l, "update") || contains(action_l, "rename") || contains(action_l, "transfer") {
    activity_id = 3
  }
}

activity_name = "Other"
if class_uid == 3002 {
  activity_name = "Logon"
} else if class_uid == 3007 {
  if activity_id == 1 {
    activity_name = "Create"
  } else if activity_id == 2 {
    activity_name = "Update"
  } else if activity_id == 3 {
    activity_name = "Delete"
  } else if activity_id == 4 {
    activity_name = "Enable"
  } else if activity_id == 5 {
    activity_name = "Disable"
  } else if activity_id == 6 {
    activity_name = "Lock"
  } else if activity_id == 7 {
    activity_name = "Unlock"
  }
} else if class_uid == 3006 {
  if activity_id == 3 {
    activity_name = "Add User"
  } else if activity_id == 4 {
    activity_name = "Remove User"
  } else if activity_id == 5 {
    activity_name = "Delete"
  } else if activity_id == 6 {
    activity_name = "Create"
  } else if activity_id == 9 {
    activity_name = "Update"
  }
} else if class_uid == 3004 {
  if activity_id == 1 {
    activity_name = "Create"
  } else if activity_id == 3 {
    activity_name = "Update"
  } else if activity_id == 4 {
    activity_name = "Delete"
  }
}

status_id = 0
if class_uid == 3002 {
  status_id = 1
}

# --- source endpoint -----------------------------------------------------

actor_ip = string(raw.actor_ip) ?? ""
src = {}
if is_ipv4(actor_ip) || is_ipv6(actor_ip) {
  src.ip = actor_ip
}
location = if is_object(raw.actor_location) { raw.actor_location } else { {} }
country = string(location.country_name) ?? ""
if country == "" {
  country = string(location.country_code) ?? ""
}
if country != "" && length(keys(src)) > 0 {
  src.location = {"country": country}
}
# --- HTTP request --------------------------------------------------------

http = {}
if (string(raw.method) ?? "") != "" {
  http.http_method = upcase(string(raw.method) ?? "")
}
if (string(raw.referrer) ?? "") != "" {
  http.referrer = string(raw.referrer) ?? ""
}
if (string(raw.url) ?? "") != "" {
  http.url = {"url_string": string(raw.url) ?? ""}
}
if (string(raw.user_agent) ?? "") != "" {
  http.user_agent = string(raw.user_agent) ?? ""
}

# --- class-specific required attributes ----------------------------------

class_name = "API Activity"
if class_uid == 3002 {
  class_name = "Authentication"
} else if class_uid == 3007 {
  class_name = "User Management"
} else if class_uid == 3006 {
  class_name = "Group Management"
} else if class_uid == 3004 {
  class_name = "Entity Management"
}

out = {
  "class_uid": class_uid,
  "class_name": class_name,
  "category_uid": category_uid,
  "type_uid": class_uid * 100 + activity_id,
  "time": time_ms,
  "severity_id": 1,
  "activity_name": activity_name,
  "message": action,
  "actor": actor,
  "metadata": {
    "version": "1.9.0",
    "log_name": "GitHub audit log",
    "log_provider": "GitHub",
    "event_code": action,
    "product": {"name": "GitHub Audit Log", "vendor_name": "GitHub"},
  },
}
if class_uid == 3002 {
  out.category_name = "Identity & Access Management"
} else if class_uid == 3007 || class_uid == 3006 || class_uid == 3004 {
  out.category_name = "Identity & Access Management"
} else {
  out.category_name = "Application Activity"
}
out.activity_id = activity_id
if status_id > 0 {
  out.status_id = status_id
}
if document_uid != "" {
  out.metadata.uid = document_uid
}
if length(keys(src)) > 0 {
  out.src_endpoint = src
}
if length(keys(http)) > 0 {
  out.http_request = http
}

if class_uid == 3002 {
  if length(keys(target_user)) == 0 {
    abort "GitHub authentication event without a user"
  }
  out.user = target_user
  out.service = {"name": "GitHub"}
  if contains(downcase(issuer), "saml") || contains(action_l, "sso") {
    out.auth_protocol_id = 5
    out.auth_protocol = "SAML"
  }
  out.logon_type_id = 99
  out.logon_type = "Other"
} else if class_uid == 3007 {
  if length(keys(target_user)) == 0 {
    abort "GitHub user event without a user"
  }
  out.user = target_user
} else if class_uid == 3006 {
  group = {}
  if team != "" {
    group.name = team
  }
  if length(keys(group)) == 0 {
    abort "GitHub team event without a team"
  }
  out.group = group
  if length(keys(target_user)) > 0 {
    out.user = target_user
  }
} else if class_uid == 3004 {
  entity = {"type_id": 4, "type": "Organization"}
  entity_name = org
  if entity_name == "" {
    entity_name = business
  }
  if entity_name != "" {
    entity.name = entity_name
  }
  if account_uid != "" {
    entity.uid = account_uid
  }
  if length(keys(entity)) == 0 {
    abort "GitHub organization event without an entity"
  }
  out.entity = entity
} else {
  if length(keys(src)) == 0 {
    abort "GitHub API event without a valid actor IP"
  }
  out.api = {"operation": action, "service": {"name": "github"}}
}

unmapped = {
  "transport_protocol": string(raw.transport_protocol_name) ?? "",
  "programmatic_access_type": string(raw.programmatic_access_type) ?? "",
  "repository": string(raw.repository) ?? "",
  "repository_uid": to_string(to_int(raw.repository_id) ?? 0),
  "external_identity_username": string(raw.external_identity_username) ?? "",
}
if (string(raw.hashed_token) ?? "") != "" {
  unmapped.hashed_token = string(raw.hashed_token) ?? ""
}
if (string(raw.request_id) ?? "") != "" {
  unmapped.request_uid = string(raw.request_id) ?? ""
}
if length(keys(unmapped)) > 0 {
  out.unmapped = unmapped
}
. = out
