# TRex EMU emulated-client traffic records (JSON) -> OCSF network classes.
#
# Raw: kind=dns|http|dhcp|icmp|arp|netflow (netflow when missing) with client_ip, server_ip|ns_server, sport, dport,
# proto, client_mac; DNS adds query, qtype, rcode; HTTP adds method, url, status.
#   dns  -> DNS Activity (4003): Traffic when the record has a response code, else Query
#   http -> HTTP Activity (4002): the activity is the request method
#   else -> Network Activity (4001), Traffic
# A record without a usable client or server address is rejected: these classes need an endpoint.

ingested = timestamp(%ironcyde.ingested_at) ?? now()
raw = parse_json(string(.message) ?? "") ?? null
if !is_object(raw) && .kind != null {
  raw = .
}
if !is_object(raw) {
  abort "no_match"
}
kind = downcase(to_string(raw.kind) ?? "")
if kind == "" {
  kind = "netflow"
}

src_ip = to_string(raw.client_ip) ?? ""
if !(is_ipv4(src_ip) || is_ipv6(src_ip)) {
  src_ip = ""
}
dst_ip = to_string(raw.server_ip) ?? ""
if dst_ip == "" {
  dst_ip = to_string(raw.ns_server) ?? ""
}
if !(is_ipv4(dst_ip) || is_ipv6(dst_ip)) {
  dst_ip = ""
}
if src_ip == "" && dst_ip == "" {
  abort "no_match"
}
src = {"ip": src_ip, "mac": to_string(raw.client_mac) ?? ""}
dst = {"ip": dst_ip}
# A port belongs to an endpoint that has an address; an endpoint of only a port is not valid.
sport = to_int(raw.sport) ?? 0
if src_ip != "" && sport > 0 && sport < 65536 {
  src.port = sport
}
dport = to_int(raw.dport) ?? 0
if dst_ip != "" && dport > 0 && dport < 65536 {
  dst.port = dport
}

# direction_id 0 (Unknown): the emulator does not say which side of a boundary a client is on.
proto = downcase(to_string(raw.proto) ?? "")
connection_info = null
if proto != "" {
  connection_info = {"protocol_name": proto, "direction_id": 0}
  proto_num = get({"icmp": 1, "tcp": 6, "udp": 17, "icmpv6": 58}, [proto]) ?? null
  if proto_num != null {
    connection_info.protocol_num = proto_num
  }
}

original_time = to_string(raw.timestamp) ?? ""
time_ms = to_unix_timestamp(ingested, unit: "milliseconds")
parsed_ts = parse_timestamp(original_time, format: "%+") ?? null
if parsed_ts != null {
  time_ms = to_unix_timestamp!(parsed_ts, unit: "milliseconds")
}

class_uid = 4001
activity_id = 6
. = {
  "category_uid": 4,
  "severity_id": 1,
  "time": time_ms,
  "message": "TRex EMU " + kind,
  "src_endpoint": src,
  "dst_endpoint": dst,
  "metadata": {
    "version": "1.9.0",
    "product": {"name": "TRex EMU", "vendor_name": "Cisco"},
    "log_name": kind,
    "original_time": original_time,
    "profiles": [],
  },
  "unmapped": {
    "emu_profile": to_string(raw.profile) ?? "",
    "emu_namespace": raw.emu_namespace,
    "emu_thread": raw.emu_thread,
  },
}

if kind == "dns" {
  query_hostname = to_string(raw.query) ?? ""
  rcode = to_string(raw.rcode) ?? ""
  class_uid = 4003
  activity_id = 1
  .message = "TRex EMU dns " + query_hostname
  # dns_query requires a hostname; a record without a query name keeps the endpoints only.
  if query_hostname != "" {
    .query = {"hostname": query_hostname, "type": to_string(raw.qtype) ?? ""}
  }
  if proto != "" {
    .connection_info = connection_info
  }
  if rcode != "" {
    activity_id = 6
    # get() gives null for an unlisted key, and to_int(null) is 0 (NoError), so the fallback is explicit.
    known_rcode = get({"noerror": 0, "formerr": 1, "formerror": 1, "servfail": 2, "serverror": 2, "nxdomain": 3, "notimp": 4, "refused": 5, "yxdomain": 6, "yxrrset": 7, "nxrrset": 8, "notauth": 9, "notzone": 10}, [downcase(rcode)]) ?? null
    rcode_id = 99
    if known_rcode != null {
      rcode_id = to_int(known_rcode) ?? 99
    }
    .rcode_id = rcode_id
    # rcode is the caption of rcode_id; the source's own spelling is kept only for codes OCSF does not list.
    .rcode = get({"0": "NoError", "1": "FormError", "2": "ServError", "3": "NXDomain", "4": "NotImp", "5": "Refused", "6": "YXDomain", "7": "YXRRSet", "8": "NXRRSet", "9": "NotAuth", "10": "NotZone"}, [to_string(rcode_id)]) ?? null
    if .rcode == null {
      .rcode = rcode
    }
    if rcode_id == 0 {
      .status_id = 1
      .status = "Success"
    } else {
      .status_id = 2
      .status = "Failure"
    }
  }
} else if kind == "http" {
  method = upcase(to_string(raw.method) ?? "")
  url = to_string(raw.url) ?? ""
  class_uid = 4002
  activity_id = to_int(get({"CONNECT": 1, "DELETE": 2, "GET": 3, "HEAD": 4, "OPTIONS": 5, "POST": 6, "PUT": 7, "TRACE": 8, "PATCH": 9}, [method]) ?? 0) ?? 0
  if activity_id == 0 && method != "" {
    activity_id = 99
    .activity_name = method
  }
  .message = strip_whitespace("TRex EMU http " + method + " " + url)
  # http_method is an enum of the registered methods; any other method is named by activity_name only.
  .http_request = {}
  if activity_id != 0 && activity_id != 99 {
    .http_request.http_method = method
  }
  if starts_with(url, "/") {
    .http_request.url = {"path": url}
  } else if url != "" {
    .http_request.url = {"url_string": url}
  }
  if proto != "" {
    .connection_info = connection_info
  }
  code = to_int(raw.status) ?? 0
  if code >= 100 && code < 600 {
    .http_response = {"code": code}
    if code < 400 {
      .status_id = 1
      .status = "Success"
    } else {
      .status_id = 2
      .status = "Failure"
    }
  }
  # HTTP Activity needs a request or a response.
  if .http_request == {} && !exists(.http_response) {
    abort "no_match"
  }
} else {
  if proto != "" {
    .connection_info = connection_info
  }
}
.class_uid = class_uid
.activity_id = activity_id
.type_uid = class_uid * 100 + activity_id
. = compact(., array: false)
