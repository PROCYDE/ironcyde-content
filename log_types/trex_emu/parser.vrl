# trex-emu traffic records → OCSF (gateway envelope).
#
# Raw: kind=dns|http|dhcp|netflow|arp|icmp plus client/server fields.
# Sets parse_status=ok|no_match. Never emits class_uid 2001.

ingested = timestamp(%ironcyde.ingested_at) ?? now()
text = string(.message) ?? ""
raw = parse_json(text) ?? null
if !is_object(raw) {
    if .kind != null {
        raw = .
    }
}
if raw == null {
  abort "no_match"
} else {
  kind = downcase(to_string(raw.kind) ?? "")
  if kind == "" {
    kind = "netflow"
  }
  src_ip = to_string(raw.client_ip) ?? ""
  dst_ip = to_string(raw.server_ip) ?? ""
  if dst_ip == "" {
    dst_ip = to_string(raw.ns_server) ?? ""
  }
  proto = downcase(to_string(raw.proto) ?? "tcp")

  category_uid = 4
  class_uid = 4001
  activity_id = 1
  severity_id = 1
  query_hostname = ""
  message = "e2e-emu-" + kind

  if kind == "dns" {
    class_uid = 4003
    query_hostname = to_string(raw.query) ?? ""
    message = "e2e-emu-dns " + query_hostname
  } else if kind == "http" {
    class_uid = 4002
    message = "e2e-emu-http " + (to_string(raw.method) ?? "GET") + " " + (to_string(raw.url) ?? "")
  } else if kind == "dhcp" {
    class_uid = 4001
    severity_id = 1
  } else if kind == "icmp" || kind == "arp" {
    class_uid = 4001
  }

  type_uid = class_uid * 100 + activity_id
  sport = to_int(raw.sport) ?? 0
  dport = to_int(raw.dport) ?? 0

  . = {
    "category_uid": category_uid,
    "class_uid": class_uid,
    "type_uid": type_uid,
    "activity_id": activity_id,
    "severity_id": severity_id,
    "time": to_unix_timestamp(now(), unit: "milliseconds"),
    "message": message,
    "src_endpoint": {"ip": src_ip, "port": sport},
    "dst_endpoint": {"ip": dst_ip, "port": dport},
    "connection_info": {"protocol_name": proto, "direction_id": 1},
    "metadata": {
      "version": "1.9.0",
      "product": {"name": "trex-emu", "vendor_name": "Cisco"},
      "profiles": [],
    },
    "unmapped": {
      "emu_kind": kind,
      "client_mac": raw.client_mac,
    },
  }
  # DNS Activity (4003) owns query; Network Activity (4001) must not emit it.
  if class_uid == 4003 {
    .query = {"hostname": query_hostname}
  }
}
