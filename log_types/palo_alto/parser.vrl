# Palo Alto firewall / threat log (JSON or CEF-ish fields) → OCSF Network Activity.
#
# Gateway envelope: event=<JSON string>. Prefer JSON keys src/dst/sport/dport/proto/action.
# Scale: one parse, prefix severity from action/severity. Never class 2001.

ingested = timestamp(%ironcyde.ingested_at) ?? now()
text = string(.message) ?? ""
raw = parse_json(text) ?? null
if !is_object(raw) {
    if .src != null || .src_ip != null || .SourceAddress != null {
        raw = .
    }
}
if !is_object(raw) {
    abort "no_match"
}
    src_ip = to_string(raw.src) ?? ""
    if src_ip == "" {
        src_ip = to_string(raw.src_ip) ?? ""
    }
    if src_ip == "" {
        src_ip = to_string(raw.SourceAddress) ?? ""
    }
    dst_ip = to_string(raw.dst) ?? ""
    if dst_ip == "" {
        dst_ip = to_string(raw.dst_ip) ?? ""
    }
    if dst_ip == "" {
        dst_ip = to_string(raw.DestinationAddress) ?? ""
    }
    sport = to_int(raw.sport) ?? 0
    if sport == 0 {
        sport = to_int(raw.src_port) ?? 0
    }
    if sport == 0 {
        sport = to_int(raw.SourcePort) ?? 0
    }
    dport = to_int(raw.dport) ?? 0
    if dport == 0 {
        dport = to_int(raw.dst_port) ?? 0
    }
    if dport == 0 {
        dport = to_int(raw.DestinationPort) ?? 0
    }
    proto = downcase(to_string(raw.proto) ?? "")
    if proto == "" {
        proto = downcase(to_string(raw.Protocol) ?? "tcp")
    }
    action = downcase(to_string(raw.action) ?? "")
    if action == "" {
        action = downcase(to_string(raw.Action) ?? "")
    }
    app = to_string(raw.app) ?? ""
    if app == "" {
        app = to_string(raw.Application) ?? ""
    }
    rule = to_string(raw.rule) ?? ""
    if rule == "" {
        rule = to_string(raw.Rule) ?? ""
    }
    threat = to_string(raw.threat_name) ?? ""
    if threat == "" {
        threat = to_string(raw.Threat_Name) ?? ""
    }

    if src_ip != "" {
        ok4 = is_ipv4(src_ip)
        ok6 = is_ipv6(src_ip)
        if !ok4 && !ok6 { src_ip = "" }
    }
    if dst_ip != "" {
        ok4 = is_ipv4(dst_ip)
        ok6 = is_ipv6(dst_ip)
        if !ok4 && !ok6 { dst_ip = "" }
    }

    category_uid = 4
    class_uid = 4001
    class_name = "Network Activity"
    activity_id = 1
    severity_id = 2
    status_id = 1

    if action == "deny" || action == "drop" || action == "reset-both" || action == "reset-client" || action == "reset-server" {
        status_id = 2
        severity_id = 3
        activity_id = 2
    }
    if threat != "" {
        category_uid = 2
        class_uid = 2004
        class_name = "Detection Finding"
        severity_id = 4
        activity_id = 1
    }

    type_uid = class_uid * 100 + activity_id

    # Empty-string fields must not short-circuit ?? — check each key explicitly.
    time_ms = 0
    ts_str = to_string(raw.receive_time) ?? ""
    if ts_str == "" {
        ts_str = to_string(raw.time_generated) ?? ""
    }
    if ts_str == "" {
        ts_str = to_string(raw.timestamp) ?? ""
    }
    if ts_str != "" {
        parsed_ts = parse_timestamp(ts_str, format: "%+") ?? null
        if parsed_ts != null {
            time_ms = to_unix_timestamp(parsed_ts, unit: "milliseconds") ?? 0
        }
    }
    if time_ms == 0 {
        time_ms = to_unix_timestamp(ingested, unit: "milliseconds")
    }

    msg = "palo " + action + " " + proto + " " + src_ip + ":" + to_string(sport) + "->" + dst_ip + ":" + to_string(dport)
    if threat != "" {
        msg = msg + " threat=" + threat
    }
    if app != "" {
        msg = msg + " app=" + app
    }

    cat_name = "Network Activity"
    if category_uid == 2 {
        cat_name = "Findings"
    }

    . = {
        "category_uid": category_uid,
        "class_uid": class_uid,
        "class_name": class_name,
        "category_name": cat_name,
        "type_uid": type_uid,
        "activity_id": activity_id,
        "severity_id": severity_id,
        "status_id": status_id,
        "time": time_ms,
        "message": msg,
        "src_endpoint": { "ip": src_ip, "port": sport },
        "dst_endpoint": { "ip": dst_ip, "port": dport },
        "connection_info": { "protocol_name": proto, "direction_id": 1 },
        "metadata": {
            "version": "1.9.0",
            "uid": to_string(raw.serial) ?? "",
            "log_name": "traffic",
            "log_provider": "Palo Alto Networks",
            "product": { "name": "PAN-OS", "vendor_name": "Palo Alto Networks" },
        },
        "unmapped": {
            "action": action,
            "app": app,
            "rule": rule,
            "threat_name": threat,
        },
    }

    if class_uid == 2004 {
        .finding = {
            "title": threat,
            "uid": threat,
        }
    }
