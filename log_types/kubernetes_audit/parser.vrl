# Kubernetes API server audit events (audit.k8s.io/v1 JSON) -> OCSF API Activity (6003).
#
# The activity follows the verb: create -> Create, get/list/watch -> Read, update/patch -> Update,
# delete/deletecollection -> Delete, anything else -> Other (named by the verb). The outcome is the response code,
# when the stage has one. An object without a verb is rejected.

ingested = timestamp(%ironcyde.ingested_at) ?? now()
e = parse_json(string(.message) ?? "") ?? null
if !is_object(e) {
  abort "not a JSON object"
}
verb = downcase(string(e.verb) ?? "")
if verb == "" {
  abort "not an audit event"
}

original_time = string(e.requestReceivedTimestamp) ?? ""
if original_time == "" {
  original_time = string(e.stageTimestamp) ?? ""
}
ts = parse_timestamp(original_time, "%+") ?? ingested
time_ms = to_unix_timestamp(ts, unit: "milliseconds")

activity_id = if verb == "create" {
  1
} else if includes(["get", "list", "watch"], verb) {
  2
} else if includes(["update", "patch"], verb) {
  3
} else if includes(["delete", "deletecollection"], verb) {
  4
} else {
  99
}

# The response exists from the ResponseStarted stage on; before that there is no outcome.
code = 0
if is_object(e.responseStatus) {
  code = to_int(e.responseStatus.code) ?? 0
}
status_id = null
status = null
if code >= 100 && code < 400 {
  status_id = 1
  status = "Success"
} else if code >= 400 {
  status_id = 2
  status = "Failure"
}

oref = if is_object(e.objectRef) { e.objectRef } else { {} }
resources = null
o_name = string(oref.name) ?? ""
o_uid = string(oref.uid) ?? ""
if o_name != "" || o_uid != "" {
  resources = [compact({
    "name": o_name,
    "uid": o_uid,
    "type": string(oref.resource) ?? "",
    "namespace": string(oref.namespace) ?? "",
    "version": string(oref.apiVersion) ?? "",
    "role_id": 1,
    "role": "Target",
  })]
}

# The first source address is the client; the others are the proxies in between. src_endpoint is required, so an
# event without a usable address names none.
src = {"name": "unknown"}
ips = []
for_each(array(e.sourceIPs) ?? []) -> |_i, ip| {
  ip_str = string(ip) ?? ""
  if is_ipv4(ip_str) || is_ipv6(ip_str) {
    ips = push(ips, ip_str)
  }
}
if length(ips) > 0 {
  src = {"ip": ips[0]}
  if length(ips) > 1 {
    src.intermediate_ips = slice!(ips, 1)
  }
}

u = if is_object(e.user) { e.user } else { {} }
username = string(u.username) ?? ""
user = {"name": username, "uid": string(u.uid) ?? ""}
groups = []
for_each(array(u.groups) ?? []) -> |_i, g| {
  group = string(g) ?? ""
  if group != "" {
    groups = push(groups, {"name": group})
  }
}
if length(groups) > 0 {
  user.groups = groups
}
if starts_with(username, "system:serviceaccount:") {
  user.type_id = 4
  user.type = "Service"
} else if starts_with(username, "system:") {
  user.type_id = 3
  user.type = "System"
}
user = compact(user)
# actor is required; an event without a user names none.
if !exists(user.name) && !exists(user.uid) {
  user = {"name": "unknown"}
}
actor = {"user": user}
# The authorizer's decision (allow or forbid) and its reason.
decision = string(e.annotations."authorization.k8s.io/decision") ?? ""
if decision != "" {
  actor.authorizations = [{"decision": decision}]
}

api = {"operation": verb, "version": string(oref.apiVersion) ?? ""}
audit_id = string(e.auditID) ?? ""
if audit_id != "" {
  api.request = {"uid": audit_id}
}
api_group = string(oref.apiGroup) ?? ""
if api_group != "" {
  api.group = {"name": api_group}
}
resp_msg = ""
if is_object(e.responseStatus) {
  resp_msg = string(e.responseStatus.message) ?? ""
}
if code > 0 {
  api.response = {"code": code, "message": resp_msg}
}

request_uri = string(e.requestURI) ?? ""
http_request = {"user_agent": string(e.userAgent) ?? ""}
if request_uri != "" {
  uri_parts = split(request_uri, "?", 2)
  http_request.url = {"path": uri_parts[0], "query_string": uri_parts[1]}
}

. = {
  "class_uid": 6003,
  "category_uid": 6,
  "activity_id": activity_id,
  "type_uid": 600300 + activity_id,
  "time": time_ms,
  "severity_id": 1,
  "status_id": status_id,
  "status": status,
  "status_detail": resp_msg,
  "message": strip_whitespace("Kubernetes audit: " + verb + " " + request_uri),
  "metadata": {
    "product": {"name": "Kubernetes", "vendor_name": "Kubernetes"},
    "version": "1.9.0",
    "uid": audit_id,
    "log_name": "audit",
    "log_level": string(e.level) ?? "",
    "original_time": original_time,
    "profiles": [],
  },
  "actor": actor,
  "api": api,
  "src_endpoint": src,
  "http_request": http_request,
  "resources": resources,
  "unmapped": {
    "stage": e.stage,
    "stageTimestamp": e.stageTimestamp,
    "annotations": e.annotations,
    "impersonatedUser": e.impersonatedUser,
    "user_extra": u.extra,
  },
}
# Activity Other is named by the verb.
if activity_id == 99 {
  .activity_name = verb
}
if code > 0 {
  .status_code = to_string(code)
  .http_response = {"code": code}
}
. = compact(., array: false)
