# Adapted for IRONCYDE staging UI / ADR-0016 from ironcyde-sergio
# source: go/internal/api/vector/vrl/defender_edr_to_ocsf.vrl
# contract: .message in → abort on fail → OCSF object out (no lineage/parse_status)
# REVIEW before promote: run gate tests with synth samples.

# Microsoft Defender for Endpoint alert JSON → OCSF Detection Finding (2004) / Process (1007).
# Gateway envelope. Never class_uid 2001. Scale: one parse_json, fixed unmapped keys.

ingested = timestamp(%ironcyde.ingested_at) ?? now()
text = string(.message) ?? ""
raw = parse_json(text) ?? null
if !is_object(raw) {
    if .AlertId != null || .alertId != null || .Title != null || .title != null {
        raw = .
    }
}
if !is_object(raw) {
    abort "no_match"
}
    title = to_string(raw.Title) ?? ""
    if title == "" {
        title = to_string(raw.title) ?? "Defender alert"
    }
    alert_id = to_string(raw.AlertId) ?? ""
    if alert_id == "" {
        alert_id = to_string(raw.alertId) ?? ""
    }
    severity_raw = downcase(to_string(raw.Severity) ?? "")
    if severity_raw == "" {
        severity_raw = downcase(to_string(raw.severity) ?? "medium")
    }
    severity_id = 3
    if severity_raw == "informational" || severity_raw == "low" {
        severity_id = 2
    } else if severity_raw == "medium" {
        severity_id = 3
    } else if severity_raw == "high" {
        severity_id = 4
    } else if severity_raw == "critical" {
        severity_id = 5
    }

    category_uid = 2
    class_uid = 2004
    activity_id = 1
    type_uid = class_uid * 100 + activity_id

    host = to_string(raw.DeviceName) ?? ""
    if host == "" {
        host = to_string(raw.deviceName) ?? ""
    }
    if host == "" {
        host = to_string(raw.ComputerDnsName) ?? ""
    }
    actor = to_string(raw.AccountName) ?? ""
    if actor == "" {
        actor = to_string(raw.accountName) ?? ""
    }
    proc = to_string(raw.FileName) ?? ""
    if proc == "" {
        proc = to_string(raw.fileName) ?? ""
    }
    if proc == "" {
        proc = to_string(raw.ProcessName) ?? ""
    }
    cmd = to_string(raw.ProcessCommandLine) ?? ""
    if cmd == "" {
        cmd = to_string(raw.processCommandLine) ?? ""
    }
    src_ip = to_string(raw.RemoteIP) ?? ""
    if src_ip == "" {
        src_ip = to_string(raw.remoteIP) ?? ""
    }
    if src_ip != "" {
        ok4 = is_ipv4(src_ip)
        ok6 = is_ipv6(src_ip)
        if !ok4 && !ok6 { src_ip = "" }
    }

    # Empty-string fields must not short-circuit ?? — check each key explicitly.
    time_ms = 0
    ts_str = to_string(raw.EventTime) ?? ""
    if ts_str == "" {
        ts_str = to_string(raw.eventTime) ?? ""
    }
    if ts_str == "" {
        ts_str = to_string(raw.Timestamp) ?? ""
    }
    if ts_str != "" {
        parsed_ts = parse_timestamp(ts_str, format: "%+") ?? null
        if parsed_ts != null {
            time_ms = to_unix_timestamp(parsed_ts, unit: "milliseconds") ?? 0
        }
    }
    if time_ms == 0 {
        time_ms = to_unix_timestamp(ingested, unit: "milliseconds")
    }

    msg = "defender " + title
    if proc != "" {
        msg = msg + " proc=" + proc
    }

    . = {
        "category_uid": category_uid,
        "class_uid": class_uid,
        "class_name": "Detection Finding",
        "category_name": "Findings",
        "type_uid": type_uid,
        "activity_id": activity_id,
        "severity_id": severity_id,
        "status_id": 1,
        "time": time_ms,
        "message": msg,
        "finding_info": {
            "title": title,
            "uid": alert_id,
            "types": ["TTPs/Detection"],
        },
        "metadata": {
            "version": "1.9.0",
            "uid": alert_id,
            "log_name": "Alert",
            "log_provider": "Microsoft Defender for Endpoint",
            "product": { "name": "Microsoft Defender for Endpoint", "vendor_name": "Microsoft" },
            "profiles": ["security_control"],
        },
        "unmapped": {
            "alert_id": alert_id,
            "severity": severity_raw,
            "category": to_string(raw.Category) ?? to_string(raw.category) ?? "",
            "actor_user": actor,
            "device_hostname": host,
            "process_name": proc,
            "process_cmd": cmd,
            "src_ip": src_ip,
        },
    }
