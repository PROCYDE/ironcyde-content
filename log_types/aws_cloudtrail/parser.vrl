# Adapted for IRONCYDE staging UI / ADR-0016 from ironcyde-sergio
# source: go/internal/api/vector/vrl/aws_cloudtrail_to_ocsf.vrl
# contract: .message in → abort on fail → OCSF object out (no lineage/parse_status)
# REVIEW before promote: run gate tests with synth samples.

# AWS CloudTrail JSON → OCSF API Activity (class_uid 6003).
#
# Input is a gateway Kafka envelope:
#   event_id, source_id, source_type, ingested_at, event=<CloudTrail JSON string>
# Offline/tests may also pass CloudTrail fields already flattened on the root.
#
# Field logic adapted from nano OCSF CloudTrail remap + nano-rs identity rules:
# never use assumed-role session ARN suffix as actor.user.name (cardinality bomb).
# Never emits deprecated security_finding 2001.

ingested = timestamp(%ironcyde.ingested_at) ?? now()
text = string(.message) ?? ""
raw = parse_json(text) ?? null
if !is_object(raw) {
    if .eventName != null || .eventSource != null {
        raw = .
    }
}
if !is_object(raw) {
    abort "no_match"
}
    ui = if is_object(raw.userIdentity) { raw.userIdentity } else { {} }

    # Stable actor name: userName > role/user segment of ARN > accountId. Never session suffix.
    caller = to_string(ui.userName) ?? ""
    arn_str = to_string(ui.arn) ?? ""
    if caller == "" && arn_str != "" {
        arn_parts = split(arn_str, "/")
        if length(arn_parts) >= 2 {
            caller = to_string(arn_parts[1])
        } else {
            colon_parts = split(arn_str, ":")
            if length(colon_parts) >= 6 {
                caller = to_string(colon_parts[5])
            }
        }
    }
    if caller == "" {
        caller = to_string(ui.accountId) ?? ""
    }

    # eventSource "s3.amazonaws.com" → service "s3"
    event_source = to_string(raw.eventSource) ?? ""
    svc = ""
    src_parts = split(event_source, ".")
    if length(src_parts) > 0 {
        svc = to_string(src_parts[0])
    }

    error_code = to_string(raw.errorCode) ?? ""
    status_id = 1
    severity_id = 1
    if error_code != "" {
        status_id = 2
        severity_id = 2
    }

    read_only = false
    if is_boolean(raw.readOnly) {
        read_only = raw.readOnly == true
    }

    event_name = to_string(raw.eventName) ?? ""
    event_name_l = downcase(event_name)
    activity_id = 99
    if read_only || starts_with(event_name_l, "describe") || starts_with(event_name_l, "list") || starts_with(event_name_l, "get") || starts_with(event_name_l, "lookup") {
        activity_id = 2
    } else if starts_with(event_name_l, "create") || starts_with(event_name_l, "put") || starts_with(event_name_l, "run") || starts_with(event_name_l, "start") || starts_with(event_name_l, "attach") {
        activity_id = 1
    } else if starts_with(event_name_l, "update") || starts_with(event_name_l, "modify") || starts_with(event_name_l, "set") || starts_with(event_name_l, "send") {
        activity_id = 3
    } else if starts_with(event_name_l, "delete") || starts_with(event_name_l, "stop") || starts_with(event_name_l, "remove") || starts_with(event_name_l, "detach") {
        activity_id = 4
    }

    # High-signal Stratus / destructive APIs → elevate severity when successful too.
    if contains(event_name_l, "stoplogging") || contains(event_name_l, "deletetrail") || contains(event_name_l, "createuser") || contains(event_name_l, "attachuserpolicy") {
        if severity_id < 4 {
            severity_id = 4
        }
    }

    class_uid = 6003
    category_uid = 6
    type_uid = class_uid * 100 + activity_id

    time_ms = to_unix_timestamp(ingested, unit: "milliseconds")
    ts_str = to_string(raw.eventTime) ?? ""
    if ts_str != "" {
        parsed_ts = parse_timestamp(ts_str, format: "%+") ?? null
        if parsed_ts != null {
            time_ms = to_unix_timestamp!(parsed_ts, unit: "milliseconds")
        }
    }

    src_ip = to_string(raw.sourceIPAddress) ?? ""
    # Polymorphic: DNS hostnames / "AWS Internal" are not IPs — leave empty for promote.
    if src_ip != "" {
        ipv4_ok = is_ipv4(src_ip)
        ipv6_ok = is_ipv6(src_ip)
        if !ipv4_ok && !ipv6_ok {
            src_ip = ""
        }
    }

    msg = event_name
    if svc != "" && event_name != "" {
        msg = svc + ":" + event_name
    }
    if error_code != "" {
        msg = msg + " (" + error_code + ")"
    }

    account_uid = to_string(raw.recipientAccountId) ?? ""
    if account_uid == "" {
        account_uid = to_string(ui.accountId) ?? ""
    }

    . = {
        "category_uid": category_uid,
        "class_uid": class_uid,
        "class_name": "API Activity",
        "category_name": "Application Activity",
        "type_uid": type_uid,
        "activity_id": activity_id,
        "severity_id": severity_id,
        "status_id": status_id,
        "time": time_ms,
        "message": msg,
        "api": {
            "operation": event_name,
            "service": {
                "name": svc,
            },
        },
        "actor": {
            "user": {
                "name": caller,
                "uid": to_string(ui.principalId) ?? "",
            },
        },
        "src_endpoint": {
            "ip": src_ip,
        },
        "metadata": {
            "version": "1.9.0",
            "uid": to_string(raw.eventID) ?? "",
            "log_name": "CloudTrail",
            "log_provider": "AWS CloudTrail",
            "correlation_uid": to_string(raw.requestID) ?? "",
            "product": {
                "name": "AWS CloudTrail",
                "vendor_name": "Amazon",
            },
        },
        "unmapped": {
            "event_source": event_source,
            "event_type": to_string(raw.eventType) ?? "",
            "error_code": error_code,
            "error_message": to_string(raw.errorMessage) ?? "",
            "user_agent": to_string(raw.userAgent) ?? "",
            "user_arn": arn_str,
            "read_only": to_string(raw.readOnly) ?? "",
            "source_ip_raw": to_string(raw.sourceIPAddress) ?? "",
            "aws_region": to_string(raw.awsRegion) ?? "",
            "aws_account_uid": account_uid,
            "cloud_provider": "AWS",
            "caller_type": to_string(ui.type) ?? "",
        },
    }

    ua = to_string(raw.userAgent) ?? ""
    if ua != "" {
        .http_request = {
            "user_agent": ua,
        }
    }
