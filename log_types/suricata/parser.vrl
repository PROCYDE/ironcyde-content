# Suricata EVE JSON -> OCSF.
#
#   alert -> Detection Finding (2004), Create: the signature is the analytic, the flow's endpoints are evidence
#   dns   -> DNS Activity (4003): Query or Response by dns.type
#   http  -> HTTP Activity (4002): the activity is the request method
#   flow and every other event type that has addresses -> Network Activity (4001), Traffic
# A record without an event type, or a network record without a valid address (stats, for example), is rejected.

ingested = timestamp(%ironcyde.ingested_at) ?? now()
raw = parse_json(string(.message) ?? "") ?? null
if !is_object(raw) && .event_type != null {
  raw = .
}
if !is_object(raw) {
  abort "no_match"
}
event_type = downcase(to_string(raw.event_type) ?? "")
if event_type == "" {
  abort "no_match"
}

src_ip = to_string(raw.src_ip) ?? ""
if !(is_ipv4(src_ip) || is_ipv6(src_ip)) {
  src_ip = ""
}
dst_ip = to_string(raw.dest_ip) ?? ""
if dst_ip == "" {
  dst_ip = to_string(raw.dst_ip) ?? ""
}
if !(is_ipv4(dst_ip) || is_ipv6(dst_ip)) {
  dst_ip = ""
}
# A port belongs to an endpoint that has an address.
src = {"ip": src_ip}
src_port = to_int(raw.src_port) ?? 0
if src_ip != "" && src_port > 0 && src_port < 65536 {
  src.port = src_port
}
dst = {"ip": dst_ip}
dst_port = to_int(raw.dest_port) ?? 0
if dst_ip != "" && dst_port > 0 && dst_port < 65536 {
  dst.port = dst_port
}

# direction_id 0 (Unknown): EVE does not say which side of a boundary the flow crosses.
proto = downcase(to_string(raw.proto) ?? "")
connection_info = {
  "direction_id": 0,
  "protocol_name": proto,
  "uid": to_string(raw.flow_id) ?? "",
  "community_uid": to_string(raw.community_id) ?? "",
}
proto_num = get({"icmp": 1, "tcp": 6, "udp": 17, "ipv6-icmp": 58, "icmpv6": 58, "sctp": 132}, [proto]) ?? null
if proto_num != null {
  connection_info.protocol_num = proto_num
}
app_proto = to_string(raw.app_proto) ?? ""

original_time = to_string(raw.timestamp) ?? ""
time_ms = to_unix_timestamp(ingested, unit: "milliseconds")
parsed_ts = parse_timestamp(original_time, format: "%+") ?? null
if parsed_ts != null {
  time_ms = to_unix_timestamp!(parsed_ts, unit: "milliseconds")
}

class_uid = 4001
category_uid = 4
activity_id = 6
. = {
  "severity_id": 1,
  "time": time_ms,
  "message": "Suricata " + event_type,
  "metadata": {
    "version": "1.9.0",
    "product": {"name": "Suricata", "vendor_name": "OISF"},
    "log_name": event_type,
    "original_time": original_time,
    "profiles": [],
  },
  "unmapped": {
    "in_iface": to_string(raw.in_iface) ?? "",
  },
}

if event_type == "alert" {
  alert = if is_object(raw.alert) { raw.alert } else { {} }
  class_uid = 2004
  category_uid = 2
  activity_id = 1
  # Suricata's severity is the rule priority: 1 is the highest.
  severity_id = 0
  if alert.severity != null {
    sev = to_int(alert.severity) ?? 0
    severity_id = if sev == 1 { 4 } else if sev == 2 { 3 } else if sev == 3 { 2 } else if sev >= 4 { 1 } else { 0 }
  }
  .severity_id = severity_id
  signature = to_string(alert.signature) ?? ""
  sid = to_string(alert.signature_id) ?? ""
  .message = strip_whitespace("Suricata alert " + signature)
  .status_id = 1
  .status = "New"
  .is_alert = true
  finding_uid = "suricata-" + sid
  if sid == "" {
    finding_uid = string(%ironcyde.event_id) ?? ""
  }
  .finding_info = {"title": signature, "uid": finding_uid}
  if sid != "" || signature != "" {
    .finding_info.analytic = {
      "type_id": 1,
      "type": "Rule",
      "uid": sid,
      "name": signature,
      "category": to_string(alert.category) ?? "",
      "version": to_string(alert.rev) ?? "",
    }
  }
  evidence = {}
  if src_ip != "" {
    evidence.src_endpoint = src
  }
  if dst_ip != "" {
    evidence.dst_endpoint = dst
  }
  if length(evidence) > 0 {
    evidence.connection_info = connection_info
    .evidences = [evidence]
  }
  # EVE verdict reports the packet outcome across all rules; alert.action is for the matching rule.
  rule_action = downcase(string(alert.action) ?? "")
  verdict = downcase(string(raw.verdict.action) ?? "")
  passed = includes(["alert", "pass", "accept"], verdict)
  if verdict == "drop" || (rule_action == "blocked" && !passed) {
    .action_id = 2
    .action = "Denied"
    .disposition_id = if verdict == "drop" { 6 } else { 2 }
    .disposition = if verdict == "drop" { "Dropped" } else { "Blocked" }
    .metadata.profiles = ["security_control"]
  } else if passed || rule_action == "allowed" {
    .action_id = 1
    .action = "Allowed"
    .disposition_id = 1
    .disposition = "Allowed"
    .metadata.profiles = ["security_control"]
  }
  if verdict == "drop" || passed {
    .unmapped.rule_action = rule_action
  }
  .unmapped.app_proto = app_proto
  .unmapped.gid = alert.gid
} else {
  if src_ip == "" && dst_ip == "" {
    abort "no_match"
  }
  .src_endpoint = src
  .dst_endpoint = dst
  .connection_info = connection_info
  .app_protocol_name = app_proto
  if event_type == "dns" {
    dns = if is_object(raw.dns) { raw.dns } else { {} }
    class_uid = 4003
    dns_type = downcase(to_string(dns.type) ?? "")
    activity_id = if dns_type == "query" || dns_type == "request" { 1 } else if dns_type == "answer" || dns_type == "response" { 2 } else { 0 }
    # The name and type are flat (EVE DNS version 1 and 2) or in the first entry of queries (version 3).
    rrname = to_string(dns.rrname) ?? ""
    rrtype = to_string(dns.rrtype) ?? ""
    if rrname == "" && is_array(dns.queries) {
      rrname = to_string(dns.queries[0].rrname) ?? ""
      rrtype = to_string(dns.queries[0].rrtype) ?? ""
    }
    .message = strip_whitespace("Suricata dns " + dns_type + " " + rrname)
    # dns_query requires a hostname.
    if rrname != "" {
      .query = {"hostname": rrname, "type": rrtype}
    }
    if dns.id != null {
      .transaction_id = to_int(dns.id) ?? null
    }
    rcode = upcase(to_string(dns.rcode) ?? "")
    if rcode != "" {
      # get() gives null for an unlisted key, and to_int(null) is 0 (NoError), so the fallback is explicit.
      known_rcode = get({"NOERROR": 0, "FORMERR": 1, "SERVFAIL": 2, "NXDOMAIN": 3, "NOTIMP": 4, "REFUSED": 5, "YXDOMAIN": 6, "YXRRSET": 7, "NXRRSET": 8, "NOTAUTH": 9, "NOTZONE": 10}, [rcode]) ?? null
      rcode_id = 99
      if known_rcode != null {
        rcode_id = to_int(known_rcode) ?? 99
      }
      .rcode_id = rcode_id
      # rcode is the caption of rcode_id; the source's own spelling is kept only for codes OCSF does not list.
      .rcode = get({"0": "NoError", "1": "FormError", "2": "ServError", "3": "NXDomain", "4": "NotImp", "5": "Refused", "6": "YXDomain", "7": "YXRRSet", "8": "NXRRSet", "9": "NotAuth", "10": "NotZone"}, [to_string(rcode_id)]) ?? null
      if .rcode == null {
        .rcode = rcode
      }
      if rcode_id == 0 {
        .status_id = 1
        .status = "Success"
      } else {
        .status_id = 2
        .status = "Failure"
      }
    }
    # Answers: only records that carry data (dns_answer requires rdata).
    answers = []
    for_each(array(dns.answers) ?? []) -> |_i, a| {
      rdata = to_string(a.rdata) ?? ""
      if rdata != "" {
        answer = {"rdata": rdata, "type": to_string(a.rrtype) ?? "", "hostname": to_string(a.rrname) ?? ""}
        if a.ttl != null {
          answer.ttl = to_int(a.ttl) ?? null
        }
        answers = push(answers, compact(answer))
      }
    }
    if length(answers) > 0 {
      .answers = answers
    }
  } else if event_type == "http" {
    http = if is_object(raw.http) && raw.http != {} {
      raw.http
    } else if is_object(raw.http_request) {
      raw.http_request
    } else {
      {}
    }
    class_uid = 4002
    method = upcase(to_string(http.http_method) ?? "")
    activity_id = to_int(get({"CONNECT": 1, "DELETE": 2, "GET": 3, "HEAD": 4, "OPTIONS": 5, "POST": 6, "PUT": 7, "TRACE": 8, "PATCH": 9}, [method]) ?? 0) ?? 0
    request = {
      "user_agent": to_string(http.http_user_agent) ?? "",
      "version": to_string(http.protocol) ?? "",
      "referrer": to_string(http.http_refer) ?? "",
    }
    # http_method is an enum of the registered methods; any other method is named by activity_name only.
    if activity_id != 0 {
      request.http_method = method
    } else if method != "" {
      activity_id = 99
      .activity_name = method
    }
    # EVE logs the request target (usually a path) and the Host header separately. Suricata's http events are
    # cleartext HTTP, so the two make the full URL.
    target = to_string(http.url) ?? ""
    host = to_string(http.hostname) ?? ""
    url = {"hostname": host}
    if starts_with(target, "/") {
      path_parts = split(target, "?", 2)
      url.path = path_parts[0]
      url.query_string = path_parts[1]
      if host != "" {
        url.scheme = "http"
        url.url_string = "http://" + host + target
      }
    } else if target != "" {
      url.url_string = target
    }
    url = compact(url)
    if exists(url.path) || exists(url.url_string) {
      request.url = url
    }
    request = compact(request)
    if length(request) > 0 {
      .http_request = request
    }
    code = to_int(http.status) ?? 0
    if code >= 100 && code < 600 {
      .http_response = {"code": code, "content_type": to_string(http.http_content_type) ?? ""}
      resp_len = to_int(http.length) ?? 0
      if resp_len > 0 {
        .http_response.length = resp_len
      }
      if code < 400 {
        .status_id = 1
        .status = "Success"
      } else {
        .status_id = 2
        .status = "Failure"
      }
    }
    # HTTP Activity needs a request or a response.
    if !exists(.http_request) && !exists(.http_response) {
      abort "no_match"
    }
    .message = strip_whitespace("Suricata http " + method + " " + host + target)
  } else if event_type == "flow" && is_object(raw.flow) {
    flow = object!(raw.flow)
    traffic = {}
    if flow.bytes_toserver != null && flow.bytes_toclient != null {
      bytes_out = to_int(flow.bytes_toserver) ?? 0
      bytes_in = to_int(flow.bytes_toclient) ?? 0
      traffic.bytes_out = bytes_out
      traffic.bytes_in = bytes_in
      traffic.bytes = bytes_out + bytes_in
    }
    if flow.pkts_toserver != null && flow.pkts_toclient != null {
      packets_out = to_int(flow.pkts_toserver) ?? 0
      packets_in = to_int(flow.pkts_toclient) ?? 0
      traffic.packets_out = packets_out
      traffic.packets_in = packets_in
      traffic.packets = packets_out + packets_in
    }
    if length(traffic) > 0 {
      .traffic = traffic
    }
    flow_start = parse_timestamp(to_string(flow.start) ?? "", format: "%+") ?? null
    flow_end = parse_timestamp(to_string(flow.end) ?? "", format: "%+") ?? null
    if flow_start != null && flow_end != null {
      start_ms = to_unix_timestamp!(flow_start, unit: "milliseconds")
      end_ms = to_unix_timestamp!(flow_end, unit: "milliseconds")
      .start_time = start_ms
      .end_time = end_ms
      .duration = end_ms - start_ms
    }
    .status_code = to_string(flow.state) ?? ""
    .unmapped.flow_reason = to_string(flow.reason) ?? ""
  }
}
.category_uid = category_uid
.class_uid = class_uid
.activity_id = activity_id
.type_uid = class_uid * 100 + activity_id
. = compact(., array: false)
