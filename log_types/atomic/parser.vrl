# Atomic Red Team simulated technique artifacts → OCSF (gateway envelope).
#
# Raw event fields (JSON string in .event):
#   technique_uid, technique_name, tactic_uid, tactic_name,
#   process, cmd_line, host, user, atomic_test, class_uid, category_uid,
#   activity_id, severity_id
#
# Sets parse_status=ok|no_match. ATT&CK technique lives in unmapped (and
# finding_info for Detection Finding). Never emits class_uid 2001.

ingested = timestamp(%ironcyde.ingested_at) ?? now()
text = string(.message) ?? ""
raw = parse_json(text) ?? null
if !is_object(raw) {
    if .technique_uid != null {
        raw = .
    }
}
if raw == null || (to_string(raw.technique_uid) ?? "") == "" {
  abort "no_match"
} else {
  class_uid = to_int(raw.class_uid) ?? 1007
  activity_id = to_int(raw.activity_id) ?? 1
  severity_id = to_int(raw.severity_id) ?? 3
  if activity_id == 0 {
    activity_id = 1
  }
  if severity_id == 0 {
    severity_id = 3
  }
  if class_uid == 2001 {
    class_uid = 2004
  }
  # category always derived from class — ignore stale raw.category_uid drift
  category_uid = 1
  if class_uid == 2004 {
    category_uid = 2
  } else if class_uid == 4001 {
    category_uid = 4
  } else if class_uid == 3002 || class_uid == 3003 {
    category_uid = 3
  }
  type_uid = class_uid * 100 + activity_id

  technique_uid = to_string(raw.technique_uid) ?? ""
  technique_name = to_string(raw.technique_name) ?? ""
  tactic_uid = to_string(raw.tactic_uid) ?? ""
  tactic_name = to_string(raw.tactic_name) ?? ""
  process_name = to_string(raw.process) ?? ""
  if process_name == "" {
    process_name = "unknown"
  }
  cmd_line = to_string(raw.cmd_line) ?? ""
  host = to_string(raw.host) ?? ""
  if host == "" {
    host = "atomic-host"
  }
  user = to_string(raw.user) ?? ""
  if user == "" {
    user = "unknown"
  }
  atomic_test = to_string(raw.atomic_test) ?? ""

  attack = {
    "technique": {"uid": technique_uid, "name": technique_name},
    "tactic": {"uid": tactic_uid, "name": tactic_name},
  }

  message = "e2e-atomic-" + technique_uid + " " + technique_name + " [" + atomic_test + "]"

  . = {
    "category_uid": category_uid,
    "class_uid": class_uid,
    "type_uid": type_uid,
    "activity_id": activity_id,
    "severity_id": severity_id,
    "time": to_unix_timestamp(now(), unit: "milliseconds"),
    "message": message,
    "metadata": {
      "version": "1.9.0",
      "product": {"name": "Atomic Red Team", "vendor_name": "Red Canary"},
      "profiles": [],
    },
    "unmapped": {
      "attacks": [attack],
      "atomic_test": atomic_test,
      "technique_uid": technique_uid,
      "technique_name": technique_name,
      "tactic_uid": tactic_uid,
      "tactic_name": tactic_name,
    },
  }

  if class_uid == 2004 {
    .metadata.profiles = ["security_control"]
    .finding_info = {
      "title": technique_name,
      "uid": "atomic-" + technique_uid,
      "types": ["TTPs/Detection"],
    }
  } else if class_uid == 3002 {
    .user = {"name": user}
    .actor = {"user": {"name": user}}
    .dst_endpoint = {"hostname": host}
    .unmapped.device_hostname = host
  } else {
    # Process Activity (default). Catalogue often stores bare exe names; Sigma
    # Image maps to process.file.path and matches '%\\foo.exe', so expand bare
    # names to a System32-style path while keeping basename in process.name.
    process_path = process_name
    process_basename = process_name
    if contains(process_name, "\\") {
      path_parts = split(process_name, "\\")
      process_basename = to_string(path_parts[-1])
    } else if contains(process_name, "/") {
      path_parts = split(process_name, "/")
      process_basename = to_string(path_parts[-1])
    } else if process_name != "" && process_name != "unknown" {
      if process_name == "powershell.exe" || process_name == "pwsh.exe" {
        process_path = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\" + process_name
      } else {
        process_path = "C:\\Windows\\System32\\" + process_name
      }
    }
    process = {
      "name": process_basename,
      "cmd_line": cmd_line,
      "file": {"path": process_path, "name": process_basename, "type_id": 1},
      "uid": process_basename,
    }
    .actor = {"user": {"name": user}}
    .device = {"hostname": host, "type_id": 99, "type": "Other"}
    if class_uid == 4001 {
      # Network Activity has no process attribute: the process that connects is the actor's, from the test host.
      .actor.process = process
      .src_endpoint = {"hostname": host}
    } else {
      .process = process
    }
    # actor and device are core in System Activity (1xxx), Windows registry classes (201xxx) and the few classes
    # below; in every other OCSF 1.9.0 class at least one of them belongs to the host profile.
    system_class = (class_uid >= 1000 && class_uid < 2000) || (class_uid >= 201000 && class_uid < 202000)
    if !system_class && !includes([2006, 5001, 5002, 5019, 5020], class_uid) {
      .metadata.profiles = ["host"]
    }
  }
}
