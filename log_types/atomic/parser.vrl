# Atomic Red Team test executions (JSON records of a simulated technique) -> OCSF.
#
# Raw fields: technique_uid, technique_name, tactic_uid, tactic_name, process, cmd_line, host, user, atomic_test,
# class_uid, activity_id, severity_id, timestamp. The record's class_uid picks the class:
#   2004 (and the deprecated 2001) -> Detection Finding: the process and user are evidence
#   3002                           -> Authentication on the host
#   4001                           -> Network Activity from the host (host profile)
#   anything else                  -> Process Activity (1007): every record describes a process that ran
# The ATT&CK mapping goes to attacks (security_control profile), or to finding_info.attacks in a finding.
# A record without a technique is rejected.

ingested = timestamp(%ironcyde.ingested_at) ?? now()
raw = parse_json(string(.message) ?? "") ?? null
if !is_object(raw) && .technique_uid != null {
  raw = .
}
if !is_object(raw) {
  abort "no_match"
}
technique_uid = to_string(raw.technique_uid) ?? ""
if technique_uid == "" {
  abort "no_match"
}

class_uid = to_int(raw.class_uid) ?? 0
if class_uid == 2001 {
  class_uid = 2004
} else if !includes([2004, 3002, 4001], class_uid) {
  class_uid = 1007
}
# The record's activity when the class defines it, else the class's first activity (Launch, Create, Logon, Open).
activity_id = to_int(raw.activity_id) ?? 0
max_activity = to_int(get({"1007": 5, "2004": 3, "3002": 7, "4001": 7}, [to_string(class_uid)]) ?? 1) ?? 1
if activity_id < 1 || activity_id > max_activity {
  activity_id = 1
}
severity_id = to_int(raw.severity_id) ?? 0
if severity_id < 1 || severity_id > 6 {
  severity_id = 0
}

technique_name = to_string(raw.technique_name) ?? ""
atomic_test = to_string(raw.atomic_test) ?? ""
host = to_string(raw.host) ?? ""
user = to_string(raw.user) ?? ""
cmd_line = to_string(raw.cmd_line) ?? ""
process_path = to_string(raw.process) ?? ""

original_time = to_string(raw.timestamp) ?? ""
time_ms = to_unix_timestamp(ingested, unit: "milliseconds")
parsed_ts = parse_timestamp(original_time, format: "%+") ?? null
if parsed_ts != null {
  time_ms = to_unix_timestamp!(parsed_ts, unit: "milliseconds")
}

# ATT&CK: "T1055.001" is a sub-technique of "T1055"; its name is "<technique>: <sub-technique>".
attack = {"tactic": {"uid": to_string(raw.tactic_uid) ?? "", "name": to_string(raw.tactic_name) ?? ""}}
if contains(technique_uid, ".") {
  name_parts = split(technique_name, ": ", 2)
  attack.technique = {"uid": string!(split(technique_uid, ".", 2)[0]), "name": name_parts[0]}
  attack.sub_technique = {"uid": technique_uid, "name": name_parts[1]}
} else {
  attack.technique = {"uid": technique_uid, "name": technique_name}
}
attack = compact(attack)

# The process: a path gives the file's path and name; a bare name is only a name. OCSF needs a process identifier
# and the record has none, so this event's own ID stands in.
process_name = process_path
if contains(process_path, "\\") {
  process_name = string(split(process_path, "\\")[-1]) ?? process_path
} else if contains(process_path, "/") {
  process_name = string(split(process_path, "/")[-1]) ?? process_path
}
process = {"name": process_name, "cmd_line": cmd_line, "uid": string(%ironcyde.event_id) ?? ""}
if process_name != "" {
  process.file = {"name": process_name, "type_id": 1}
  if process_name != process_path {
    process.file.path = process_path
  }
}
if user != "" {
  process.user = {"name": user}
}
has_process = process_name != "" || cmd_line != ""

# Required identities are placeholders when the record names none.
user_name = user
if user_name == "" {
  user_name = "unknown"
}
# type_id 0 (Unknown): the record does not say what kind of device the host is.
device = {"type_id": 0}
if host != "" {
  device.hostname = host
} else {
  device.name = "unknown"
}

message = strip_whitespace("Atomic Red Team " + technique_uid + " " + technique_name)
if atomic_test != "" {
  message = message + " [" + atomic_test + "]"
}

. = {
  "category_uid": to_int(floor(class_uid / 1000)),
  "class_uid": class_uid,
  "type_uid": class_uid * 100 + activity_id,
  "activity_id": activity_id,
  "severity_id": severity_id,
  "time": time_ms,
  "message": message,
  "metadata": {
    "version": "1.9.0",
    "product": {"name": "Atomic Red Team", "vendor_name": "Red Canary"},
    "event_code": atomic_test,
    "original_time": original_time,
    "profiles": ["security_control"],
  },
}

if class_uid == 2004 {
  .metadata.profiles = []
  .status_id = 1
  .status = "New"
  .finding_info = {
    "title": technique_name,
    "uid": string(%ironcyde.event_id) ?? "",
    "attacks": [attack],
  }
  if host != "" {
    .device = device
  }
  if has_process {
    .evidences = [{"process": process}]
  } else if user != "" {
    .evidences = [{"user": {"name": user}}]
  }
} else if class_uid == 3002 {
  # attacks belongs to the security_control profile. The host is where the logon happened.
  .attacks = [attack]
  .user = {"name": user_name}
  if host != "" {
    .dst_endpoint = {"hostname": host}
  } else {
    .dst_endpoint = {"name": "unknown"}
  }
  if has_process {
    .logon_process = process
  }
} else if class_uid == 4001 {
  # device and actor belong to the host profile in Network Activity: the process connects from the test host.
  .metadata.profiles = ["security_control", "host"]
  .attacks = [attack]
  .device = device
  .actor = {"user": {"name": user_name}}
  if has_process {
    .actor.process = process
  }
  if host != "" {
    .src_endpoint = {"hostname": host}
  } else {
    .src_endpoint = {"name": "unknown"}
  }
} else {
  .attacks = [attack]
  .device = device
  .actor = {"user": {"name": user_name}}
  .process = process
}
. = compact(., array: false)
