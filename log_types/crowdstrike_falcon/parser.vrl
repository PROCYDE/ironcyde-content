# CrowdStrike Falcon detection summaries (DetectionSummaryEvent JSON) -> OCSF Detection Finding (2004), Create.
#
# Reads the PascalCase stream fields and the snake_case forms some exports use. The host goes to device, the
# detected process, its user and the remote address to evidences, the ATT&CK mapping to finding_info.attacks.
# An object that names no detection (no name and no ID) is rejected.

ingested = timestamp(%ironcyde.ingested_at) ?? now()
raw = parse_json(string(.message) ?? "") ?? null
if !is_object(raw) && (.DetectName != null || .detect_name != null || .DetectionId != null || .aid != null) {
  raw = .
}
if !is_object(raw) {
  abort "no_match"
}

# to_string(null) is "", not an error, so alternatives are tried one by one.
title = to_string(raw.DetectName) ?? ""
if title == "" {
  title = to_string(raw.detect_name) ?? ""
}
if title == "" {
  title = to_string(raw.Name) ?? ""
}
det_id = to_string(raw.DetectionId) ?? ""
if det_id == "" {
  det_id = to_string(raw.detection_id) ?? ""
}
if det_id == "" {
  det_id = to_string(raw.id) ?? ""
}
if title == "" && det_id == "" {
  abort "no_match"
}

# Severity: the name when present; else the number, 1-5 in detection summaries and 0-100 in newer alerts.
severity_name = downcase(to_string(raw.SeverityName) ?? "")
severity_id = to_int(get({"informational": 1, "low": 2, "medium": 3, "high": 4, "critical": 5}, [severity_name]) ?? 0) ?? 0
if severity_id == 0 {
  severity_name = downcase(to_string(raw.severity) ?? "")
  severity_id = to_int(get({"informational": 1, "low": 2, "medium": 3, "high": 4, "critical": 5}, [severity_name]) ?? 0) ?? 0
}
if severity_id == 0 {
  sev_num = to_int(raw.Severity) ?? 0
  if sev_num == 0 {
    sev_num = to_int(raw.severity) ?? 0
  }
  if sev_num >= 1 && sev_num <= 5 {
    severity_id = sev_num
  } else if sev_num > 5 {
    severity_id = if sev_num < 20 { 1 } else if sev_num < 40 { 2 } else if sev_num < 60 { 3 } else if sev_num < 80 { 4 } else { 5 }
  }
}

host = to_string(raw.ComputerName) ?? ""
if host == "" {
  host = to_string(raw.hostname) ?? ""
}
if host == "" {
  host = to_string(raw.device_name) ?? ""
}
user = to_string(raw.UserName) ?? ""
if user == "" {
  user = to_string(raw.user_name) ?? ""
}
proc = to_string(raw.FileName) ?? ""
if proc == "" {
  proc = to_string(raw.filename) ?? ""
}
if proc == "" {
  proc = to_string(raw.ImageFileName) ?? ""
}
cmd = to_string(raw.CommandLine) ?? ""
if cmd == "" {
  cmd = to_string(raw.cmdline) ?? ""
}
local_ip = to_string(raw.LocalIP) ?? ""
if local_ip == "" {
  local_ip = to_string(raw.local_ip) ?? ""
}
if !(is_ipv4(local_ip) || is_ipv6(local_ip)) {
  local_ip = ""
}
remote_ip = to_string(raw.RemoteAddress) ?? ""
if !(is_ipv4(remote_ip) || is_ipv6(remote_ip)) {
  remote_ip = ""
}

# Detection time: epoch seconds or milliseconds (Falcon often sends them as strings) or ISO 8601.
original_time = to_string(raw.timestamp) ?? ""
if original_time == "" {
  original_time = to_string(raw.created_timestamp) ?? ""
}
if original_time == "" {
  original_time = to_string(raw.ProcessStartTime) ?? ""
}
time_ms = to_unix_timestamp(ingested, unit: "milliseconds")
epoch = to_float(original_time) ?? 0.0
if epoch > 1000000000000.0 {
  time_ms = to_int(epoch)
} else if epoch > 1000000000.0 {
  time_ms = to_int(epoch * 1000.0)
} else {
  parsed_ts = parse_timestamp(original_time, format: "%+") ?? null
  if parsed_ts != null {
    time_ms = to_unix_timestamp!(parsed_ts, unit: "milliseconds")
  }
}

# ATT&CK: Falcon names the tactic and the technique; with a sub-technique ID ("T1003.001") the name is the
# sub-technique's.
tactic = to_string(raw.Tactic) ?? ""
if tactic == "" {
  tactic = to_string(raw.tactic) ?? ""
}
technique = to_string(raw.Technique) ?? ""
if technique == "" {
  technique = to_string(raw.technique) ?? ""
}
technique_uid = to_string(raw.TechniqueId) ?? ""
attack = {"tactic": {"name": tactic}}
if contains(technique_uid, ".") {
  attack.technique = {"uid": string!(split(technique_uid, ".", 2)[0])}
  attack.sub_technique = {"uid": technique_uid, "name": technique}
} else {
  attack.technique = {"uid": technique_uid, "name": technique}
}
attack = compact(attack)

# The detected process. OCSF needs a process identifier: Falcon's process ID, else this event's own ID.
evidence = {}
if proc != "" || cmd != "" {
  file_dir = to_string(raw.FilePath) ?? ""
  hashes = []
  sha256 = to_string(raw.SHA256HashData) ?? ""
  if sha256 == "" {
    sha256 = to_string(raw.SHA256String) ?? ""
  }
  if sha256 != "" {
    hashes = push(hashes, {"algorithm_id": 3, "algorithm": "SHA-256", "value": sha256})
  }
  md5 = to_string(raw.MD5HashData) ?? ""
  if md5 == "" {
    md5 = to_string(raw.MD5String) ?? ""
  }
  if md5 != "" {
    hashes = push(hashes, {"algorithm_id": 1, "algorithm": "MD5", "value": md5})
  }
  process_uid = to_string(raw.ProcessId) ?? ""
  if process_uid == "" {
    process_uid = string(%ironcyde.event_id) ?? ""
  }
  evidence.process = {"name": proc, "cmd_line": cmd, "uid": process_uid, "user": {"name": user}}
  if proc != "" {
    evidence.process.file = {"name": proc, "type_id": 1}
    if file_dir != "" {
      # The directory's own separator joins it to the name: "/" on Linux and macOS, "\\" on Windows.
      separator = if contains(file_dir, "/") && !contains(file_dir, "\\") { "/" } else { "\\" }
      if ends_with(file_dir, separator) {
        separator = ""
      }
      evidence.process.file.path = file_dir + separator + proc
    }
    if length(hashes) > 0 {
      evidence.process.file.hashes = hashes
    }
  }
} else if user != "" {
  evidence.user = {"name": user}
}
if remote_ip != "" {
  evidence.dst_endpoint = {"ip": remote_ip}
}

# "Prevention, process killed." / "Detection, standard detection.": Falcon's own wording is the disposition;
# its first word says whether the activity was stopped.
disposition = to_string(raw.PatternDispositionDescription) ?? ""
action_id = null
action = null
if starts_with(disposition, "Prevention") {
  action_id = 2
  action = "Denied"
} else if starts_with(disposition, "Detection") {
  action_id = 3
  action = "Observed"
}

finding_uid = det_id
if finding_uid == "" {
  finding_uid = string(%ironcyde.event_id) ?? ""
}
msg = strip_whitespace("Falcon detection " + title)
if proc != "" {
  msg = msg + " (" + proc + ")"
}

. = {
  "category_uid": 2,
  "class_uid": 2004,
  "type_uid": 200401,
  "activity_id": 1,
  "severity_id": severity_id,
  "status_id": 1,
  "status": "New",
  "is_alert": true,
  "action_id": action_id,
  "action": action,
  "time": time_ms,
  "message": msg,
  "finding_info": {
    "title": title,
    "uid": finding_uid,
    "desc": to_string(raw.DetectDescription) ?? "",
    "src_url": to_string(raw.FalconHostLink) ?? "",
  },
  # type_id 0 (Unknown): the detection does not say what kind of device the sensor runs on.
  "device": {
    "hostname": host,
    "ip": local_ip,
    "uid": to_string(raw.aid) ?? "",
    "domain": to_string(raw.MachineDomain) ?? "",
    "type_id": 0,
  },
  "metadata": {
    "version": "1.9.0",
    "uid": det_id,
    "log_name": "DetectionSummaryEvent",
    "original_time": original_time,
    "tenant_uid": to_string(raw.cid) ?? "",
    "product": {"name": "CrowdStrike Falcon", "vendor_name": "CrowdStrike"},
    "profiles": [],
  },
  "unmapped": {
    "objective": to_string(raw.Objective) ?? "",
  },
}
if length(attack) > 0 {
  .finding_info.attacks = [attack]
}
if length(evidence) > 0 {
  .evidences = [evidence]
}
# action and disposition belong to the security_control profile.
if disposition != "" {
  .disposition_id = 99
  .disposition = disposition
  .metadata.profiles = ["security_control"]
}
. = compact(., array: false)
# device needs an identity; a detection that names no host, address or sensor carries none.
if !exists(.device.hostname) && !exists(.device.ip) && !exists(.device.uid) {
  del(.device)
}
